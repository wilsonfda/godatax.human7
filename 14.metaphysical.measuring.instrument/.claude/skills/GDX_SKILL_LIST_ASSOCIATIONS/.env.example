# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/list_associations.js. Never
# commit the real ".env" file -- it is (and must stay) gitignored.
#
# These are the SAME Firebird credentials as every other GDX_HUMAN skill
# (godatax.human) -- if you already have a working .env for one of those,
# just copy it here. This skill only reads catalog/reference tables
# (GDX_PSY_CHAKRA, GDX_TA_WAY_SEPT_MAP, GDX_PSY_SEPT_LEVEL_PSY_MAP,
# GDX_PSY_SEPTENARY_LEVEL, DW_DIM_VARIABLE) -- never study/participant data,
# so there is no --study flag and no intake.json dependency.
#
# Do not add default/fallback values for these in list_associations.js. Per
# CLAUDE.md, hardcoded Firebird credentials must not be propagated into new
# code, even as "overridable defaults".

GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.on.bording.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=masterkey
