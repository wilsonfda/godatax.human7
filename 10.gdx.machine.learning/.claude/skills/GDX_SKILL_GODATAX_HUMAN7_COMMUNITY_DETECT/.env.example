# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/community_detect.js. Never
# commit the real ".env" file -- it is (and must stay) gitignored.
#
# Do not add default/fallback values for these in community_detect.js. Per
# CLAUDE.md, hardcoded Neo4j credentials must not be propagated into new
# code, even as an "overridable default".
#
# This skill reads ONLY from Neo4j -- no Firebird connection, no
# GDX_HUMAN_FB_* variables needed here.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
