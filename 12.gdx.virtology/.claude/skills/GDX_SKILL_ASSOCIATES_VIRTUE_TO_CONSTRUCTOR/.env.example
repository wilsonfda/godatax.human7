# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/associate_virtue.js. Never
# commit the real ".env" file -- it is (and must stay) gitignored.
#
# These are the SAME Firebird credentials as every other GDX_HUMAN skill
# (godatax.human) -- if you already have a working .env for one of those,
# just copy it here. This skill writes to GDX_VT_VARIABLE_VIRTUE_MAP only,
# and reads GDX_PSY_VARIABLE / GDX_PSY_CONSTRUCT / DW_DIM_VARIABLE /
# GDX_VT_VIRTUE to resolve its inputs -- never study/participant data, so
# there is no --study flag and no intake.json dependency.
#
# Do not add default/fallback values for these in associate_virtue.js. Per
# CLAUDE.md, hardcoded Firebird credentials must not be propagated into new
# code, even as "overridable defaults".

GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.onboarding.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=
