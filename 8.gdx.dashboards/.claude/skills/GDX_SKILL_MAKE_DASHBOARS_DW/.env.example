# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/make_dashboards.js. Never
# commit the real ".env" file -- it is (and must stay) gitignored.
#
# Not needed at all if you only ever run with --sample (embedded sample
# data, no database connection).
#
# Do not add default/fallback values for these in make_dashboards.js. Per
# CLAUDE.md, hardcoded Firebird credentials must not be propagated into new
# code, even as "overridable defaults".

GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.onboarding.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=masterkey

# --- Neo4j (only needed by make_master_panel.js, to report Phase 8's live export state) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
