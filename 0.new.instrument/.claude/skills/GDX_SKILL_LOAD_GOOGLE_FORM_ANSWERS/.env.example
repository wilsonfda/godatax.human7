# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/load_google_form_answers.js.
# Never commit the real ".env" file -- it is (and must stay) gitignored.
#
# Do not add default/fallback values for these in load_google_form_answers.js.
# Per this project's convention, hardcoded credentials must not be propagated
# into new code, even as "overridable defaults".

# --- Firebird: same database as every other GDX_HUMAN skill ---
GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.onboarding.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=

# --- Google OAuth client (Forms API) ---
# Same Client ID/Secret as GDX_SKILL_GENERATE_GOOGLE_FORM's .env -- see this
# skill's SKILL.md "One-time authorization" section.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the refresh token is read from/saved to after the one-time browser
# consent (never commit this file either). Both skills' scripts run with their
# own "scripts" folder as the working directory, so this relative path (from
# GDX_SKILL_LOAD_GOOGLE_FORM_ANSWERS/scripts up to .claude/skills/, then into
# GDX_SKILL_GENERATE_GOOGLE_FORM/scripts/) points at the SAME file that
# skill's default GOOGLE_OAUTH_TOKEN_PATH (./google_token.json) writes to --
# reuses that one-time consent instead of authorizing a second time. Use an
# absolute path instead if you'd rather not rely on the relative layout, or
# leave this unset (defaults to ./google_token.json, its own separate token)
# to keep the two skills' credentials fully independent.
GOOGLE_OAUTH_TOKEN_PATH=../../GDX_SKILL_GENERATE_GOOGLE_FORM/scripts/google_token.json
