# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/generate_google_form.js.
# Never commit the real ".env" file -- it is (and must stay) gitignored.
#
# Do not add default/fallback values for these in generate_google_form.js. Per
# this project's convention, hardcoded credentials must not be propagated into
# new code, even as "overridable defaults".

# --- Firebird: same database as every other GDX_HUMAN skill ---
GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.onboarding.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=

# --- Google OAuth client (Forms API) ---
# See this skill's SKILL.md "One-time authorization" section for how to get
# these two values (Google Cloud Console -> OAuth client of type "Desktop app").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the refresh token gets saved after the one-time browser consent (never
# commit this file either -- it is a credential, unlike google_form_map.json).
# Point this at the SAME path GDX_SKILL_LOAD_GOOGLE_FORM_ANSWERS's .env uses if
# you'd rather authorize once and share the token than consent twice.
GOOGLE_OAUTH_TOKEN_PATH=./google_token.json
