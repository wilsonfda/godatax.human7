# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/delete_study.js. Never commit
# the real ".env" file -- it is (and must stay) gitignored.
#
# This skill touches TWO databases -- fill in both, unless you pass
# --skip-neo4j (Firebird only, then).
#
# Do not add default/fallback values for these in delete_study.js. Per
# CLAUDE.md, hardcoded Firebird/Neo4j credentials must not be propagated into
# new code, even as "overridable defaults".

# --- Firebird (godatax.human) -- same as every other GDX_HUMAN skill ---
GDX_HUMAN_FB_HOST=localhost
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=C:/Wilson/GoDataX/GDX_HUMAN7/13.on.bording.env/GODATAX7HPH.GDB
GDX_HUMAN_FB_USER=SYSDBA
GDX_HUMAN_FB_PASSWORD=masterkey

# --- Neo4j -- same instance GDX_SKILL_GODATAX_HUMAN7_BY_SPU writes to ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
