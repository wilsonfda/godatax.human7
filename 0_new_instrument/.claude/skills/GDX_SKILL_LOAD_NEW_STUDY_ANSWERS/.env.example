# Copy this file to ".env" in the same folder (or export these as real
# environment variables) before running scripts/load_new_study_answers.js.
# Never commit the real ".env" file -- it is (and must stay) gitignored.
#
# Do not add default/fallback values for these in load_new_study_answers.js.
# Per CLAUDE.md, hardcoded Firebird credentials must not be propagated into
# new code, even as "overridable defaults". Same database/credentials as
# GDX_SKILL_NEW_STUDY / GDX_SKILL_RECORD_NEW_STUDY / GDX_SKILL_EXPORT_NEW_STUDY.

GDX_HUMAN_FB_HOST=firebird.godatax.com
GDX_HUMAN_FB_PORT=3050
GDX_HUMAN_FB_DATABASE=/firebird/godatax.gdb
GDX_HUMAN_FB_USER=godatax1
GDX_HUMAN_FB_PASSWORD=
